# Database
DATABASE_URL="postgresql://oakvale:YOUR_DB_PASSWORD@127.0.0.1:5433/oakvale?schema=public"

# Auth
AUTH_SECRET="YOUR_AUTH_SECRET"

# Paystack (TEST keys — replace with your own test keys from dashboard.paystack.com)
PAYSTACK_SECRET_KEY="sk_test_replace_me"
PAYSTACK_PUBLIC_KEY="pk_test_replace_me"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (Resend — https://resend.com/api-keys). Without a key, emails are logged, not sent.
RESEND_API_KEY="re_replace_me"
# Must be a verified domain in Resend; falls back to onboarding@resend.dev for testing.
EMAIL_FROM="Oakvale Learning <noreply@oakvalelearning.com>"
EMAIL_REPLY_TO="hello@oakvalelearning.com"

# Cron auth — protects /api/cron/payment-reminders (Vercel sends it as a Bearer token).
CRON_SECRET="YOUR_CRON_SECRET"
