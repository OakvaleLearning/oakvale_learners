// Oakvale Learning - Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LEARNER
  ADMIN
}

enum Track {
  ADULT_CARE
  CHILD_CARE
}

enum PaymentPlan {
  FULL
  SPLIT
}

enum EnrollmentStatus {
  PENDING     // created, awaiting payment
  PARTIAL     // split payment: deposit paid, balance due
  ACTIVE      // fully paid
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  // WhatsApp / phone number, stored normalised (e.g. "+2348108189514").
  // Required at signup; nullable only for accounts created before this field.
  phone        String?
  passwordHash String
  role         Role         @default(LEARNER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  enrollments  Enrollment[]
  payments     Payment[]
  resetTokens  PasswordResetToken[]
}

/// Single-use, time-limited password reset tokens. Only the SHA-256 hash of the
/// token is stored — the raw token exists solely in the emailed link.
model PasswordResetToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Enrollment {
  id          String           @id @default(cuid())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  track       Track
  plan        PaymentPlan
  status      EnrollmentStatus @default(PENDING)
  cohort      String           @default("Cohort 2")
  // amounts stored in kobo (NGN * 100) to match Paystack
  totalAmount Int
  amountPaid  Int              @default(0)
  // For SPLIT plans: when the 2nd instalment balance is due (set on deposit).
  balanceDueDate DateTime?
  // Email SOP: timestamps used to send each mail exactly once (idempotency).
  depositEmailSentAt  DateTime?
  reminderEmailSentAt DateTime?
  enrolledEmailSentAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  payments    Payment[]

  // One enrolment per learner, per track, per cohort. Re-enrolling reuses the
  // existing row rather than stacking up duplicates.
  @@unique([userId, track, cohort])
  @@index([userId])
  @@index([status])
}

model Payment {
  id           String        @id @default(cuid())
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  reference    String        @unique // Paystack transaction reference
  amount       Int // kobo
  status       PaymentStatus @default(PENDING)
  channel      String? // card, bank, etc (from Paystack)
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([enrollmentId])
  @@index([userId])
  @@index([status])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  name      String
  email     String
  // WhatsApp / phone number, stored normalised (e.g. "+2348108189514").
  // Nullable only because entries captured before this field existed have none.
  phone     String?
  track     Track?
  createdAt DateTime @default(now())

  @@index([email])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  category    String    @default("Guide")
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}
